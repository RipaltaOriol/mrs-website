# Contentful Delivery API credentials.
# Copy this file to `.env` and fill in the values.
# Rotating these: docs/runbooks/rotate-contentful-credential.md

# Contentful space the site reads its content from.
# Contentful > Settings > General settings > Space ID
CONTENTFUL_SPACE_ID=

# Content Delivery API access token (read-only). Not the Preview or Management token.
# Contentful > Settings > API keys
CONTENTFUL_ACCESS_KEY=

# Shared secret the content webhook repeats back in its `X-Webhook-Secret`
# header, so `/api/revalidate` can tell a real publish from anyone's POST.
# Generate one with `openssl rand -hex 32`. With this unset the endpoint
# refuses every call, and regeneration falls back to hourly.
# Configuring the webhook: docs/runbooks/configure-content-webhook.md
CONTENTFUL_WEBHOOK_SECRET=
